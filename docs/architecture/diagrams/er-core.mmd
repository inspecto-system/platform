        uuid property_id FK
        text name }
    inspections { uuid id PK
        uuid property_id FK
        text status }
    defect_categories { uuid id PK
        text code
        uuid owner_id FK }
    checklist_templates { uuid id PK
        text code UK }
    checklist_template_items { uuid id PK
        uuid template_id FK
        text element_group }
