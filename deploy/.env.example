# Development-only credentials for deploy/compose.dev.yaml.
# Copy to deploy/.env and change the values. Never commit deploy/.env.
POSTGRES_SUPERUSER_PASSWORD=dev-superuser-change-me

CORE_MIGRATOR_PASSWORD=dev-core-migrator-change-me
CORE_APP_PASSWORD=dev-core-app-change-me
MEDIA_MIGRATOR_PASSWORD=dev-media-migrator-change-me
MEDIA_APP_PASSWORD=dev-media-app-change-me
REPORT_MIGRATOR_PASSWORD=dev-report-migrator-change-me
REPORT_APP_PASSWORD=dev-report-app-change-me

# S3 (SeaweedFS) credentials: one identity per service, each limited to its own bucket.
S3_MEDIA_ACCESS_KEY=media-dev
S3_MEDIA_SECRET_KEY=dev-media-s3-secret-change-me
S3_REPORT_ACCESS_KEY=report-dev
S3_REPORT_SECRET_KEY=dev-report-s3-secret-change-me
S3_ADMIN_ACCESS_KEY=admin-dev
S3_ADMIN_SECRET_KEY=dev-admin-s3-secret-change-me
