# Development-only credentials for deploy/compose.dev.yaml.
# Copy to deploy/.env and change the values. Never commit deploy/.env.
# Host port of PostgreSQL; change it if 5432 is taken (e.g. by a locally installed PostgreSQL).
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=dev-superuser-change-me

CORE_MIGRATOR_PASSWORD=dev-core-migrator-change-me
CORE_APP_PASSWORD=dev-core-app-change-me
MEDIA_MIGRATOR_PASSWORD=dev-media-migrator-change-me
MEDIA_APP_PASSWORD=dev-media-app-change-me
REPORT_MIGRATOR_PASSWORD=dev-report-migrator-change-me
REPORT_APP_PASSWORD=dev-report-app-change-me

# S3 (SeaweedFS) credentials: one identity per service, each limited to its own bucket.
S3_MEDIA_ACCESS_KEY=media-dev
S3_MEDIA_SECRET_KEY=dev-media-s3-secret-change-me
S3_REPORT_ACCESS_KEY=report-dev
S3_REPORT_SECRET_KEY=dev-report-s3-secret-change-me
S3_ADMIN_ACCESS_KEY=admin-dev
S3_ADMIN_SECRET_KEY=dev-admin-s3-secret-change-me

# Secret of the service client "media-service" in core-service (client credentials, ADR-007);
# the same value is given to both services. At least 32 characters.
MEDIA_CLIENT_SECRET=dev-media-client-secret-change-me-0123456789
# Host ports of nginx (profile "apps"); HTTPS with a self-signed certificate: https://localhost:8443/api/v1/
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# Secret of the service client "report-service" in core-service, given to both services likewise.
REPORT_CLIENT_SECRET=dev-report-client-secret-change-me-0123456789

# Secret of the service client "ml-service" in core-service, given to both services likewise.
ML_CLIENT_SECRET=dev-ml-client-secret-change-me-0123456789abc
# Directory with model.onnx and model.json of ml-service (relative to deploy/ or absolute);
# the default ../../ml/data/models/current does not exist in CI: ml-service then runs without a model.
# ML_MODEL_DIR=../../ml/data/models/resnet50-logreg-917dcdb8
