# Security headers of every API response (SECURITY.md §10). Included wherever a location adds its own
# headers: nginx drops inherited add_header directives in a block that has any of its own.
include /etc/nginx/conf.d/common-headers.inc;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "no-referrer" always;
# The API returns only JSON and files: nothing in it may load or run anything. The web app sets its own policy.
add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
